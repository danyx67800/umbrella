import("//ui/webui/resources/tools/build_webui.gni")

assert(!is_android)

build_webui("build") {
  grd_prefix = "umbrella"

  static_files = [
    "app.css",
    "index.html",
    "umbrella-mark.svg",
  ]

  ts_files = [ "app.ts" ]

  ts_composite = true
  webui_context_type = "trusted"
}
